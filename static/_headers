# Cloudflare Pages headers. https://developers.cloudflare.com/pages/configuration/headers/
# CSP ships as Report-Only first (CLAUDE.md §11); enforce after a clean week by renaming the header.
# TODO: add a report-uri / report-to endpoint before the report-only week starts.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  # same-origin-allow-popups (not same-origin): the CMS login opens a GitHub/worker popup that must post the token back to /admin/.
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' https://*.hs-scripts.com https://*.hsforms.net https://*.hsforms.com https://*.hs-analytics.net https://*.hs-banner.com https://*.hscollectedforms.net https://*.hsadspixel.net https://*.usemessages.com https://*.hubspot.com https://*.hsappstatic.net https://*.hubspotusercontent-na1.net https://*.hubspotusercontent-na2.net https://*.hubspotusercontent-eu1.net https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://*.hsforms.net https://*.hubspot.com https://*.hsappstatic.net; img-src 'self' data: https://*.hubspot.com https://*.hsforms.com https://*.hsforms.net https://*.hs-analytics.net https://*.hubspotusercontent-na1.net https://*.hubspotusercontent-na2.net https://*.hubspotusercontent-eu1.net https://*.hsappstatic.net https://www.gstatic.com; font-src 'self' https://*.hsappstatic.net; connect-src 'self' https://*.hubspot.com https://*.hubapi.com https://*.hsforms.com https://*.hsforms.net https://*.hs-banner.com https://*.hscollectedforms.net https://*.hs-analytics.net https://*.hsappstatic.net https://www.google.com; frame-src https://*.hubspot.com https://*.hsforms.net https://*.hsforms.com https://www.google.com https://recaptcha.google.com; form-action 'self' https://*.hsforms.com https://*.hubspot.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

/admin/*
  ! Content-Security-Policy-Report-Only
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=3600
